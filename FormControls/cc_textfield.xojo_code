End
#tag EndWebContainerControl

#tag WindowCode
	#tag Event
		Function evGetFieldControl() As WebUIControl
		  Return me.tf
		End Function
	#tag EndEvent

	#tag Event
		Function evGetLabelControl() As webLabel
		  Return me.lbl
		End Function
	#tag EndEvent

	#tag Event
		Function evGetValue() As Variant
		  Return me.tf.Text
		End Function
	#tag EndEvent


	#tag Method, Flags = &h0
		Sub Constructor(curValueName as string, label as string, value as string)
		  Super.Constructor(curValueName,label,value)
		  Me.tf.Left=Me.lbl.Width+14
		  Me.tf.Width=Max(100,value.getWidthInPixel(Me.tf.Style.FontName,Me.tf.Style.FontSize)+5)
		  Me.tf.FieldType=WebTextField.FieldTypes.Normal
		  Me.tf.Text=value
		  Me.Width=Me.getWidth
		  Me.Height=28//Self.tf.Height
		End Sub
	#tag EndMethod


#tag EndWindowCode

