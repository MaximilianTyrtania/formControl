End
#tag EndWebContainerControl

#tag WindowCode
	#tag Event
		Function evGetFieldControl() As WebUIControl
		  Return me.RG
		End Function
	#tag EndEvent

	#tag Event
		Function evGetLabelControl() As webLabel
		  Return self.lbl
		End Function
	#tag EndEvent

	#tag Event
		Function evGetValue() As Variant
		  Return me.rg.SelectedItem.Caption
		End Function
	#tag EndEvent


	#tag Method, Flags = &h0
		Sub Constructor(curValueName as string, label as string, valuesToChooseFrom() as String, initValue as string)
		  Super.Constructor(curValueName,label,initValue)
		  Me.rg.Style=style_default
		  Me.rg.Left=Me.lbl.Width+14
		  Var selectedItemIndex As Integer=-1
		  Me.rg.Width=14
		  Var curValue As String
		  Var curRGWidth As Integer
		  For curItemIndex As Integer=0 To valuesToChooseFrom.Count-1
		    curValue=valuesToChooseFrom(curItemIndex)
		    If curValue=initValue Then
		      selectedItemIndex=curItemIndex
		    End If
		    Me.RG.Add curValue
		    Me.rg.Width=Me.rg.Width+curValue.getWidthInPixel(Me.rg.Style.FontName,Me.rg.Style.FontSize)+35//35 is jus a guess
		    curRGWidth=Me.rg.Width
		  Next
		  If selectedItemIndex>=0 Then
		    Me.RG.SelectedIndex=selectedItemIndex
		  End If
		  Me.Width=Me.getWidth
		  Me.Height=28//Self.tf.Height
		  
		End Sub
	#tag EndMethod


#tag EndWindowCode

